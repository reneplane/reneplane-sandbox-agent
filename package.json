{
  "name": "reneplane-sandbox-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reneplane Local: runs Reneplane Workspace missions on your own computer, for the IDE at workspace.reneplane.com",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts serve --dev",
    "agent": "tsx src/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pin-runtimes": "node scripts/pin-runtimes.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
